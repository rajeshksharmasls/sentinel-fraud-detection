# ============================================================
# Sentinel Fraud Investigation Agent
# Environment Configuration
# ============================================================

# LLM provider
OPENAI_API_KEY=

# Model used by specialist agents
OPENAI_MODEL=gpt-4o-mini

# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Sentinel API URL (for CLI)
SENTINEL_API_URL=http://127.0.0.1:8000

# Database
SENTINEL_DB_PATH=data/sentinel.db
SENTINEL_QUEUE_DB_PATH=data/sentinel_queue.db

# Async workers
SENTINEL_WORKER_COUNT=2

# Logging
LOG_LEVEL=INFO
